# AegisAppSec Enterprise Configuration
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_SECRET_KEY=aegis-enterprise-hardened-session-token-2026
AEGIS_JWT_SECRET=aegis-enterprise-jwt-hyper-secret-key-2026

# Database (MySQL in Docker / SQLite local fallback)
DATABASE_URL=mysql+pymysql://aegis_user:aegis_password_2026@db:3306/aegis_db
# For standalone local run without Docker:
# DATABASE_URL=sqlite:///./aegis_enterprise.db

# Message Broker & Cache
REDIS_URL=redis://redis:6379/0
# For standalone local run without Docker:
# REDIS_URL=redis://127.0.0.1:6379/0

# Rate Limiter & Concurrency
RATE_LIMIT_PER_MINUTE=120
SCANNER_MAX_CONCURRENCY=15
